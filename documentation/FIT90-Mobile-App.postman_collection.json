        "url": "{{baseUrl}}/mobile/app/subscriptions/freeze-history"
      }
    },
    {
      "name": "Get my notifications",
      "request": {
        "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{customerToken}}", "type": "string" }] },
        "method": "GET",
        "url": "{{baseUrl}}/mobile/app/notifications?limit=50"
      }
    },
    {
      "name": "Mark notification as read",
      "request": {
        "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{customerToken}}", "type": "string" }] },
        "method": "PATCH",
        "url": "{{baseUrl}}/mobile/app/notifications/{{notificationId}}/read"
      }
    },
    {
      "name": "Mark all notifications as read",
      "request": {
        "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{customerToken}}", "type": "string" }] },
        "method": "PATCH",
        "url": "{{baseUrl}}/mobile/app/notifications/read-all"
      }
    },
    {
      "name": "Delete customer account",
      "request": {
        "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{customerToken}}", "type": "string" }] },
        "method": "DELETE",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": { "mode": "raw", "raw": "{\n  \"password\": \"CurrentPassword\"\n}" },
        "url": "{{baseUrl}}/mobile/app/account"
      }
    },
