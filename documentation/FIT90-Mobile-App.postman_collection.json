    { "name": "Get exercise details", "request": { "method": "GET", "url": "{{baseUrl}}/mobile/app/exercises/{{exerciseId}}" } },
    { "name": "Get terms and conditions", "request": { "method": "GET", "url": "{{baseUrl}}/mobile/app/terms-and-conditions" } },
    { "name": "Get privacy policy", "request": { "method": "GET", "url": "{{baseUrl}}/mobile/app/privacy-policy" } },
    { "name": "Get about app", "request": { "method": "GET", "url": "{{baseUrl}}/mobile/app/about" } },
    { "name": "Get trainers", "request": { "method": "GET", "url": "{{baseUrl}}/mobile/app/trainers" } },
    { "name": "Get trainers by branch", "request": { "method": "GET", "url": "{{baseUrl}}/mobile/app/trainers?branchId={{branchId}}" } },
    { "name": "Get subscription types", "request": { "method": "GET", "url": "{{baseUrl}}/mobile/app/subscription-types" } },
    { "name": "Get subscription types by branch", "request": { "method": "GET", "url": "{{baseUrl}}/mobile/app/subscription-types?branchId={{branchId}}" } },
    { "name": "Get subscription type details", "request": { "method": "GET", "url": "{{baseUrl}}/mobile/app/subscription-types/{{subscriptionTypeId}}" } },
    { "name": "Get subscription type details by branch", "request": { "method": "GET", "url": "{{baseUrl}}/mobile/app/subscription-types/{{subscriptionTypeId}}?branchId={{branchId}}" } },
    {
