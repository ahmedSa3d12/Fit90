              "const firstSlot = json.days && json.days.flatMap(day => day.slots || [])[0];",
              "if (firstSlot && firstSlot.id) pm.collectionVariables.set('spaScheduleId', firstSlot.id);"
            ] }
          }],
          "request": {
            "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{customerToken}}", "type": "string" }] },
            "method": "GET",
