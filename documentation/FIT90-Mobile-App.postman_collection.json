    },
    { "name": "Get all ads", "request": { "method": "GET", "url": "{{baseUrl}}/mobile/app/ads" } },
    { "name": "Get ad by id", "request": { "method": "GET", "url": "{{baseUrl}}/mobile/app/ads/1" } },
