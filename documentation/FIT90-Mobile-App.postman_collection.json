              "const json = pm.response.json();",
              "if (json.id) pm.collectionVariables.set('spaBookingId', json.id);"
            ] }
          }],
          "request": {
            "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{customerToken}}", "type": "string" }] },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
