        "url": "{{baseUrl}}/mobile/app/feedback"
      }
    },
    {
      "name": "Create invitation",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": { "mode": "raw", "raw": "{\n  \"inviteeName\": \"محمد علي\",\n  \"inviteePhone\": \"+201001234567\",\n  \"inviteeGender\": \"male\",\n  \"invitedById\": 15,\n  \"invitedByName\": \"أحمد محمد\",\n  \"visitDate\": \"2026-07-20\",\n  \"branchId\": 1,\n  \"notes\": \"زيارة تجريبية\"\n}" },
        "url": "{{baseUrl}}/mobile/app/invitations"
      }
    },
    {
      "name": "Class schedules and bookings",
      "description": "Authenticated mobile-member APIs. Run Customer login first so customerToken is populated.",
      "item": [
        {
          "name": "Get class catalog",
          "request": {
            "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{customerToken}}", "type": "string" }] },
            "method": "GET",
            "url": "{{baseUrl}}/mobile/app/classes/catalog",
            "description": "Returns class types that have published future schedules."
          }
        },
        {
          "name": "Get class trainers",
          "request": {
            "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{customerToken}}", "type": "string" }] },
            "method": "GET",
            "url": "{{baseUrl}}/mobile/app/classes/trainers?classId={{classId}}",
            "description": "Returns trainers with published future slots. Remove classId to return trainers for every class."
          }
        },
        {
          "name": "Get trainer monthly schedule",
          "event": [{
            "listen": "test",
            "script": {
              "exec": [
                "const json = pm.response.json();",
                "const firstSlot = json.days && json.days.flatMap(day => day.slots || [])[0];",
                "if (firstSlot && firstSlot.id) pm.collectionVariables.set('slotId', firstSlot.id);",
                "pm.test('Class service and trainer are returned', function () {",
                "  if (firstSlot) {",
                "    pm.expect(firstSlot.service).to.have.property('name');",
                "    pm.expect(firstSlot.trainer).to.have.property('name');",
                "  }",
                "});"
              ]
            }
          }],
          "request": {
            "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{customerToken}}", "type": "string" }] },
            "method": "GET",
            "url": "{{baseUrl}}/mobile/app/classes/schedule?trainerId={{trainerId}}&year={{scheduleYear}}&month={{scheduleMonth}}&classId={{classId}}",
            "description": "Monthly schedule grouped by Cairo day. Includes availability, booking window, remaining capacity, myBooking and freeSession."
          }
        },
        {
          "name": "Get class slot details",
          "request": {
            "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{customerToken}}", "type": "string" }] },
            "method": "GET",
            "url": "{{baseUrl}}/mobile/app/classes/slots/{{slotId}}",
            "description": "Returns one member-aware class slot."
          }
        },
        {
          "name": "Create class booking",
          "event": [{
            "listen": "test",
            "script": {
              "exec": [
                "const json = pm.response.json();",
                "if (json.id) pm.collectionVariables.set('bookingId', json.id);",
                "pm.test('Booking is confirmed or waitlisted', function () {",
                "  pm.expect(['confirmed', 'wait']).to.include(json.status);",
                "});"
              ]
            }
          }],
          "request": {
            "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{customerToken}}", "type": "string" }] },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"slotId\": {{slotId}}\n}"
            },
            "url": "{{baseUrl}}/mobile/app/classes/bookings",
            "description": "Creates a confirmed booking when capacity exists; otherwise creates a wait-list booking and returns waitlistPosition."
          }
        },
        {
          "name": "Get my upcoming class bookings",
          "request": {
            "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{customerToken}}", "type": "string" }] },
            "method": "GET",
            "url": "{{baseUrl}}/mobile/app/classes/bookings/my?scope=upcoming",
            "description": "Returns upcoming confirmed and waiting bookings for the authenticated member. Optional status: confirmed, wait, cancelled, completed or no_show."
          }
        },
        {
          "name": "Get my waiting bookings",
          "request": {
            "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{customerToken}}", "type": "string" }] },
            "method": "GET",
            "url": "{{baseUrl}}/mobile/app/classes/bookings/my?status=wait&scope=upcoming",
            "description": "Returns future wait-list bookings and each booking's current waitlistPosition."
          }
        },
        {
          "name": "Cancel my class booking",
          "request": {
            "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{customerToken}}", "type": "string" }] },
            "method": "PATCH",
            "url": "{{baseUrl}}/mobile/app/classes/bookings/{{bookingId}}/cancel",
            "description": "Cancels the member's booking. If it was confirmed, the oldest waiting member is promoted automatically."
          }
        },
        {
          "name": "Get class booking notifications",
          "request": {
            "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{customerToken}}", "type": "string" }] },
            "method": "GET",
            "url": "{{baseUrl}}/mobile/app/classes/notifications",
            "description": "Returns the latest 50 class-booking notifications for the authenticated member."
          }
        }
      ]
    },
    {
      "name": "Nutrition, SPA and Personal Training",
      "description": "Unified mobile appointment APIs. appointmentCategory accepts nutrition, spa or personal_training. Every schedule and slot includes service and trainer objects.",
      "item": [
        {
          "name": "Get department services",
          "event": [{
            "listen": "test",
            "script": { "exec": [
              "const json = pm.response.json();",
              "if (json.data && json.data[0]) pm.collectionVariables.set('appointmentServiceId', json.data[0].id);"
            ] }
          }],
          "request": {
            "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{customerToken}}", "type": "string" }] },
            "method": "GET",
            "url": "{{baseUrl}}/mobile/app/appointments/services?category={{appointmentCategory}}",
            "description": "Returns services with published future schedules for nutrition, spa or personal_training."
          }
        },
        {
          "name": "Get service trainers",
          "event": [{
            "listen": "test",
            "script": { "exec": [
              "const json = pm.response.json();",
              "if (json.data && json.data[0]) pm.collectionVariables.set('appointmentTrainerId', json.data[0].id);"
            ] }
          }],
          "request": {
            "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{customerToken}}", "type": "string" }] },
            "method": "GET",
            "url": "{{baseUrl}}/mobile/app/appointments/trainers?category={{appointmentCategory}}&serviceId={{appointmentServiceId}}",
            "description": "Returns trainers/providers for the selected service."
          }
        },
        {
          "name": "Get service monthly schedule",
          "event": [{
            "listen": "test",
            "script": { "exec": [
              "const json = pm.response.json();",
              "const firstSlot = json.days && json.days.flatMap(day => day.slots || [])[0];",
              "if (firstSlot && firstSlot.id) pm.collectionVariables.set('appointmentScheduleId', firstSlot.id);",
              "pm.test('Service and trainer are returned', function () {",
              "  pm.expect(json.service).to.have.property('name');",
              "  pm.expect(json.trainer).to.have.property('name');",
              "  if (firstSlot) {",
              "    pm.expect(firstSlot.service).to.have.property('name');",
              "    pm.expect(firstSlot.trainer).to.have.property('name');",
              "  }",
              "});"
            ] }
          }],
          "request": {
            "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{customerToken}}", "type": "string" }] },
            "method": "GET",
            "url": "{{baseUrl}}/mobile/app/appointments/schedule?category={{appointmentCategory}}&serviceId={{appointmentServiceId}}&trainerId={{appointmentTrainerId}}&year={{scheduleYear}}&month={{scheduleMonth}}",
            "description": "Monthly schedule grouped by Cairo day. The response header and every slot contain service.name and trainer.name."
          }
        },
        {
          "name": "Get service slot details",
          "request": {
            "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{customerToken}}", "type": "string" }] },
            "method": "GET",
            "url": "{{baseUrl}}/mobile/app/appointments/slots/{{appointmentScheduleId}}",
            "description": "Returns one appointment with service, trainer, availability and the member's booking."
          }
        },
        {
          "name": "Create service booking",
          "event": [{
            "listen": "test",
            "script": { "exec": [
              "const json = pm.response.json();",
              "if (json.id) pm.collectionVariables.set('appointmentBookingId', json.id);",
              "pm.test('Booking includes service and trainer', function () {",
              "  pm.expect(json.service).to.have.property('name');",
              "  pm.expect(json.trainer).to.have.property('name');",
              "});"
            ] }
          }],
          "request": {
            "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{customerToken}}", "type": "string" }] },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"scheduleId\": {{appointmentScheduleId}}\n}" },
            "url": "{{baseUrl}}/mobile/app/appointments/bookings",
            "description": "Creates a confirmed booking or a wait-list booking when capacity is full."
          }
        },
        {
          "name": "Get my service bookings",
          "request": {
            "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{customerToken}}", "type": "string" }] },
            "method": "GET",
            "url": "{{baseUrl}}/mobile/app/appointments/bookings/my?category={{appointmentCategory}}&scope=upcoming",
            "description": "Returns upcoming bookings with service, trainer, schedule and wait-list position."
          }
        },
        {
          "name": "Cancel service booking",
          "request": {
            "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{customerToken}}", "type": "string" }] },
            "method": "PATCH",
            "url": "{{baseUrl}}/mobile/app/appointments/bookings/{{appointmentBookingId}}/cancel",
            "description": "Cancels the booking and promotes the oldest waiting member when applicable."
          }
        }
      ]
    },
    {
      "name": "SPA - Dedicated API",
