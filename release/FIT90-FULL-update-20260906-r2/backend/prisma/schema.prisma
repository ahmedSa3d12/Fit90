// =====================================================================================
//  ENTERPRISE RBAC (additive — coexists with legacy pages/permissions, which are untouched)
//  Tri-state role matrix (Inherit/Allow/Deny) + inheritance + user exceptions + data scopes.
//  Tables are applied to the DB via prisma/sql/rbac.sql; Prisma is used to GENERATE only.
// =====================================================================================

enum RbacResourceType {
  module
  group
  page
}

enum RbacEffect {
  allow
  deny
}

enum RbacDataScope {
  own
  team
  branch
  department
  global
}

/// Permission actions (matrix columns). `key` is the stable identifier used everywhere.
model rbac_actions {
  id         Int     @id @default(autoincrement())
  key        String  @unique @db.VarChar(40) // view/create/update/delete/approve/reject/export/print/audit/configure/execute/manage/use
  label_ar   String  @db.VarChar(80)
  label_en   String  @db.VarChar(80)
  sensitive  Boolean @default(false)
  sort_order Int     @default(0)

  resource_actions rbac_resource_actions[]
  role_permissions rbac_role_permissions[]
  exceptions       rbac_user_exceptions[]

  @@map("rbac_actions")
}

/// Resource tree (module -> group -> page). Single source of truth for permissionable nodes.
model rbac_resources {
  id         Int              @id @default(autoincrement())
  key        String           @unique @db.VarChar(120) // stable, e.g. "employees.list"
  parent_id  Int?
  type       RbacResourceType
  name_ar    String           @db.VarChar(160)
  name_en    String?          @db.VarChar(160)
  route      String?          @db.VarChar(200) // new React route, e.g. "/employees"
  icon       String?          @db.VarChar(80)
  sort_order Int              @default(0)
  is_active  Boolean          @default(true)

  parent   rbac_resources?  @relation("rbac_resource_tree", fields: [parent_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  children rbac_resources[] @relation("rbac_resource_tree")

  resource_actions rbac_resource_actions[]
  role_permissions rbac_role_permissions[]
  exceptions       rbac_user_exceptions[]
  role_scopes      rbac_role_scopes[]

  @@index([parent_id])
  @@map("rbac_resources")
}

/// Which actions are applicable on a resource (matrix shows a dash where absent).
model rbac_resource_actions {
  resource_id Int
  action_id   Int

  resource rbac_resources @relation(fields: [resource_id], references: [id], onDelete: Cascade, onUpdate: Cascade)
  action   rbac_actions   @relation(fields: [action_id], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@id([resource_id, action_id])
  @@index([action_id])
  @@map("rbac_resource_actions")
}

/// Roles. super_admin (is_super_admin) bypasses all checks; is_system can't be deleted.
model rbac_roles {
  id             Int      @id @default(autoincrement())
  key            String   @unique @db.VarChar(60)
  name_ar        String   @db.VarChar(120)
  name_en        String?  @db.VarChar(120)
  description    String?  @db.VarChar(255)
  is_system      Boolean  @default(false)
  is_super_admin Boolean  @default(false)
  created_at     DateTime @default(now())
  updated_at     DateTime @updatedAt

  permissions rbac_role_permissions[]
  user_roles  rbac_user_roles[]
  scopes      rbac_role_scopes[]

  @@map("rbac_roles")
}

/// Stored tri-state cells. Only Allow/Deny are stored; Inherit = no row.
model rbac_role_permissions {
  id          Int        @id @default(autoincrement())
  role_id     Int
  resource_id Int
  action_id   Int
  effect      RbacEffect

  role     rbac_roles     @relation(fields: [role_id], references: [id], onDelete: Cascade, onUpdate: Cascade)
  resource rbac_resources @relation(fields: [resource_id], references: [id], onDelete: Cascade, onUpdate: Cascade)
  action   rbac_actions   @relation(fields: [action_id], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@unique([role_id, resource_id, action_id])
  @@index([role_id])
  @@index([resource_id])
  @@index([action_id])
  @@map("rbac_role_permissions")
}

/// Role assignment (a user may hold many roles; optional expiry).
model rbac_user_roles {
  id         Int       @id @default(autoincrement())
  user_id    Int
  role_id    Int
  expires_at DateTime?
  created_at DateTime  @default(now())
  created_by Int?

  role rbac_roles @relation(fields: [role_id], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@unique([user_id, role_id])
  @@index([user_id])
  @@index([role_id])
  @@map("rbac_user_roles")
}

/// Per-user surgical overrides on an exact resource+action. Highest priority; deny wins.
model rbac_user_exceptions {
  id          Int        @id @default(autoincrement())
  user_id     Int
  resource_id Int
  action_id   Int
  effect      RbacEffect
  expires_at  DateTime?
  reason      String?    @db.VarChar(255)
  created_at  DateTime   @default(now())
  created_by  Int?

  resource rbac_resources @relation(fields: [resource_id], references: [id], onDelete: Cascade, onUpdate: Cascade)
  action   rbac_actions   @relation(fields: [action_id], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@unique([user_id, resource_id, action_id])
  @@index([user_id])
  @@map("rbac_user_exceptions")
}

/// Optional data-scope per role+resource (does NOT inherit; broadest wins across roles).
model rbac_role_scopes {
  id          Int           @id @default(autoincrement())
  role_id     Int
  resource_id Int
  scope       RbacDataScope

  role     rbac_roles     @relation(fields: [role_id], references: [id], onDelete: Cascade, onUpdate: Cascade)
  resource rbac_resources @relation(fields: [resource_id], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@unique([role_id, resource_id])
  @@index([role_id])
  @@map("rbac_role_scopes")
}

/// Audit trail for all RBAC administrative changes.
model rbac_audit_log {
  id            Int      @id @default(autoincrement())
  actor_user_id Int?
  action        String   @db.VarChar(60) // role.create / role.update / role.delete / role.assign / exception.update ...
  target_type   String?  @db.VarChar(40)
  target_id     String?  @db.VarChar(60)
  detail        Json?
  created_at    DateTime @default(now())

  @@index([created_at])
  @@index([actor_user_id])
  @@map("rbac_audit_log")
}

