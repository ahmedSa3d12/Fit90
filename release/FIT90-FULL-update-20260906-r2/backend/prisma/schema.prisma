  ongoing
  completed
  cancelled
}

enum ClubFitnessEnrollmentStatus {
  registered
  attended
  absent
  cancelled
}

enum ClubFitnessHallStatus {
  available
  maintenance
  unavailable
}

enum ClubFitnessBookingStatus {
  pending
  confirmed
  active
  completed
  cancelled
}

enum ClubFitnessDifficulty {
  easy
  medium
  hard
}

enum ClubFitnessPaymentStatus {
  unpaid
  paid
  partial
}

model club_trainers {
  id                Int                            @id @default(autoincrement())
  employee_id       Int?
  name              String                         @db.VarChar(200)
  email             String?                        @db.VarChar(150)
  phone             String?                        @db.VarChar(20)
  specialization    String?                        @db.VarChar(200)
  experience        String?                        @db.VarChar(100)
  bio               String?                        @db.Text
  image_url         String?                        @db.VarChar(255)
  rating_avg        Decimal                        @default(0) @db.Decimal(3, 2)
  is_active         Boolean                        @default(true)
  is_deleted        Boolean                        @default(false)
  created_at        DateTime                       @default(now())
  updated_at        DateTime                       @updatedAt
  classes           club_classes[]
  monthly_schedules club_class_monthly_schedules[]

  @@index([employee_id])
  @@map("club_trainers")
}

model club_classes {
  id           Int                      @id @default(autoincrement())
  class_name   String                   @db.VarChar(200)
  class_type   String                   @default("class") @db.VarChar(50) // class | zumba | aerobics | ... (FIT90 filter)
  description  String?                  @db.Text
  trainer_id   Int
  branch_id    Int
  hall_id      Int?
  class_date   String                   @db.VarChar(10)
  start_time   String                   @db.VarChar(8)
  end_time     String                   @db.VarChar(8)
  max_capacity Int                      @default(10)
  price        Decimal                  @default(0) @db.Decimal(10, 2)
  status       ClubFitnessClassStatus   @default(scheduled)
  notes        String?                  @db.Text
  is_active    Boolean                  @default(true)
  is_deleted   Boolean                  @default(false)
  created_at   DateTime                 @default(now())
  updated_at   DateTime                 @updatedAt
  trainer      club_trainers            @relation(fields: [trainer_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  enrollments  club_class_enrollments[]
  waitlist     club_class_waitlist[]

  @@index([trainer_id])
  @@index([branch_id])
  @@index([class_date])
  @@map("club_classes")
}

model club_class_enrollments {
  id                Int                         @id @default(autoincrement())
  class_id          Int
  member_id         Int
  enrollment_date   String                      @db.VarChar(10)
  attendance_status ClubFitnessEnrollmentStatus @default(registered)
  attendance_time   String?                     @db.VarChar(8)
  notes             String?                     @db.Text
  created_at        DateTime                    @default(now())
  updated_at        DateTime                    @updatedAt
  class             club_classes                @relation(fields: [class_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([class_id, member_id])
  @@index([member_id])
  @@map("club_class_enrollments")
}

model club_class_waitlist {
  id         Int          @id @default(autoincrement())
  class_id   Int
  member_id  Int
  position   Int          @default(0)
  status     String       @default("waiting") @db.VarChar(20)
  notes      String?      @db.Text
  created_at DateTime     @default(now())
  updated_at DateTime     @updatedAt
  class      club_classes @relation(fields: [class_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([class_id, member_id])
  @@index([class_id, status])
  @@map("club_class_waitlist")
}

model club_inbody_measurements {
  id               Int      @id @default(autoincrement())
  member_id        Int
  measurement_date String   @db.VarChar(10)
  staff_name       String?  @db.VarChar(150)
  file_url         String?  @db.VarChar(255)
  weight           Decimal? @db.Decimal(6, 2)
  body_fat         Decimal? @db.Decimal(5, 2)
  muscle_mass      Decimal? @db.Decimal(6, 2)
  bmi              Decimal? @db.Decimal(5, 2)
  notes            String?  @db.Text
  nutrition_plan   Json?
  created_at       DateTime @default(now())
  updated_at       DateTime @updatedAt

  @@index([member_id])
  @@map("club_inbody_measurements")
}

model club_spa_services {
  id           Int                 @id @default(autoincrement())
  name         String              @db.VarChar(200)
  description  String?             @db.Text
  duration     Int                 @default(60)
  price        Decimal             @db.Decimal(10, 2)
  service_kind String              @default("spa") @db.VarChar(20) // spa | additional (حجامة/مساج)
  branch_id    Int?
  is_active    Boolean             @default(true)
  created_at   DateTime            @default(now())
  updated_at   DateTime            @updatedAt
  bookings     club_spa_bookings[]
  invoices     club_spa_invoices[]

  @@map("club_spa_services")
}

model club_spa_bookings {
  id             Int                      @id @default(autoincrement())
  booking_number String                   @unique @db.VarChar(30)
  member_id      Int?
  customer_name  String?                  @db.VarChar(200)
  customer_phone String?                  @db.VarChar(20)
  service_id     Int
  branch_id      Int
  booking_date   String                   @db.VarChar(10)
  booking_time   String                   @db.VarChar(8)
