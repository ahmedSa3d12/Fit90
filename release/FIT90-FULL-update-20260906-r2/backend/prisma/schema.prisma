model api_users {
  user_id    Int     @id @default(autoincrement())
  user_name  String? @db.VarChar(100)
  user_phone String? @db.VarChar(20)
  user_email String? @db.VarChar(70)
  user_city  String? @db.VarChar(100)
  user_pass  String? @db.VarChar(500)
  status     Int     @default(0) // tinyint: 0=inactive,1=active
  rand_key   Int?
  m_image    String? @db.Text

  employees employees[]

  @@map("api_users")
}

/// Hierarchical area settings (country/city/region). Engine=MyISAM, utf8mb3. PK main_id (AI).
model conf_area_setting {
  main_id    Int       @id @default(autoincrement())
  name       String?   @db.VarChar(100)
  type       String?   @db.VarChar(10) // enum('country','city','region')
  from_id_fk Int? // self-ref parent (FK-by-convention)
  created    DateTime  @default(now()) @db.DateTime(0)
  updated    DateTime? @db.DateTime(0)

  @@map("conf_area_setting")
}

