// =====================================================================================
//  SCHEDULING & BOOKING — generic single engine (additive; supersedes the
//  fragmented per-service tables). Everything appointment-based routes through
//  club_services (catalog) -> club_schedules (slots) -> club_bookings (bookings).
//  InBody results (club_inbody_records) are independent of scheduling.
//  Rooms reuse club_class_rooms; machines reuse club_machines; providers
//  (coach/therapist) reuse club_trainers — referenced by scalar id + index.
// =====================================================================================

/// Service category. `additional` is fully dynamic (Hijama, Massage, ...).
enum ClubServiceCategory {
  class
  zumba
  nutrition
  spa
  personal_training
  inbody
  additional
}

/// Lifecycle of a schedule slot.
enum ClubScheduleStatus {
  available
  cancelled
  hidden
}

/// Lifecycle of a booking against a schedule slot.
enum ClubApptBookingStatus {
  pending
  confirmed
  wait
  completed
  cancelled
  no_show
}

enum ClassMonthlyScheduleStatus {
  draft
  published
  archived
}

enum ProviderMonthlyAvailabilityStatus {
  draft
  published
  archived
}

enum ClassScheduleSlotStatus {
  available
  unavailable
  cancelled
}

enum ClassBookingStatus {
  confirmed
  wait
  cancelled
  completed
  no_show
}

enum BookingAdditionalServiceStatus {
  confirmed
  cancelled
  completed
}

/// Service catalog — the single source of truth for every bookable service.
model club_services {
  id              Int                 @id @default(autoincrement())
  name            String              @db.VarChar(200)
  class_type_id   Int?
  category        ClubServiceCategory @default(additional)
  description     String?             @db.Text
  entitlement_key String?             @db.VarChar(50)
  duration_min    Int                 @default(60) // default slot length in minutes
  price           Decimal             @default(0) @db.Decimal(10, 2)
  capacity        Int? // optional default capacity per slot (null = single/unbounded)
  color           String?             @db.VarChar(20) // hex color for calendar coding
  branch_id       Int?
  is_active       Boolean             @default(true)
  is_deleted      Boolean             @default(false)
  created_at      DateTime            @default(now())
  updated_at      DateTime            @updatedAt

  schedules                   club_schedules[]
  monthly_schedules           club_service_monthly_schedules[]
  bookings                    club_bookings[]
  class_additional_services   club_class_additional_services[]
  slot_additional_services    club_slot_additional_services[]
  booking_additional_services club_booking_additional_services[]
  service_additional_links    club_service_additional_services[]      @relation("BaseServiceAdditionalServices")
  additional_catalog_links    club_service_additional_services[]      @relation("AdditionalServiceCatalogLinks")
  appointment_additional_uses club_appt_booking_additional_services[] @relation("AppointmentBookingAdditionalService")
  additional_schedule_uses    club_schedules[]                        @relation("ScheduleAdditionalService")

  @@index([category])
  @@index([class_type_id])
  @@index([branch_id])
  @@map("club_services")
}

/// Schedule slot — a concrete bookable time window for a service.
model club_schedules {
  id                    Int                @id @default(autoincrement())
  service_id            Int
  additional_service_id Int?
  employee_id           Int? // provider (coach/therapist) -> club_trainers.id
  room_id               Int? // -> club_class_rooms.id
  machine_id            Int? // -> club_machines.id (InBody etc.)
  branch_id             Int?
  slot_date             String             @db.VarChar(10) // yyyy-mm-dd
  start_time            String             @db.VarChar(8) // HH:mm[:ss]
  end_time              String             @db.VarChar(8)
  booking_start_at      DateTime?          @db.DateTime(0) // optional reservation opening date/time
  booking_end_at        DateTime?          @db.DateTime(0) // optional reservation closing date/time
  capacity              Int                @default(1)
  booked_count          Int                @default(0)
  status                ClubScheduleStatus @default(available)
  recurrence_group      String?            @db.VarChar(40) // groups bulk/recurring occurrences
  monthly_schedule_id   Int?
  notes                 String?            @db.Text
  is_deleted            Boolean            @default(false)
  created_at            DateTime           @default(now())
  updated_at            DateTime           @updatedAt

  service            club_services                   @relation(fields: [service_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  additional_service club_services?                  @relation("ScheduleAdditionalService", fields: [additional_service_id], references: [id], onDelete: SetNull, onUpdate: NoAction)
  monthly_schedule   club_service_monthly_schedules? @relation(fields: [monthly_schedule_id], references: [id], onDelete: SetNull, onUpdate: NoAction)
  bookings           club_bookings[]

  @@index([service_id])
  @@index([additional_service_id])
  @@index([monthly_schedule_id])
  @@index([slot_date])
  @@index([employee_id])
  @@index([room_id])
  @@index([machine_id])
  @@index([branch_id])
  @@index([status])
  @@map("club_schedules")
}

/// Publishable monthly plan for Nutrition, SPA and Personal Training services.
model club_service_monthly_schedules {
  id           Int                        @id @default(autoincrement())
  service_id   Int
  employee_id  Int
  category     ClubServiceCategory
  month        Int                        @db.TinyInt
  year         Int                        @db.SmallInt
  status       ClassMonthlyScheduleStatus @default(draft)
  published_at DateTime?                  @db.DateTime(0)
  created_at   DateTime                   @default(now()) @db.DateTime(0)
  updated_at   DateTime                   @updatedAt @db.DateTime(0)

  service club_services    @relation(fields: [service_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  slots   club_schedules[]

  @@unique([service_id, employee_id, month, year], map: "service_monthly_unique")
  @@index([category, status])
  @@map("club_service_monthly_schedules")
}

/// Booking — a member (or walk-in) reserving a schedule slot.
/// Service-independent monthly attendance plan for a nutrition specialist.
model club_provider_monthly_availabilities {
  id           Int                               @id @default(autoincrement())
  employee_id  Int
  category     ClubServiceCategory               @default(nutrition)
  month        Int                               @db.TinyInt
  year         Int                               @db.SmallInt
  status       ProviderMonthlyAvailabilityStatus @default(draft)
  published_at DateTime?                         @db.DateTime(0)
  created_at   DateTime                          @default(now()) @db.DateTime(0)
  updated_at   DateTime                          @updatedAt @db.DateTime(0)

  windows club_availability_slots[]

  @@unique([employee_id, category, month, year], map: "provider_monthly_availability_unique")
  @@index([category, status])
  @@map("club_provider_monthly_availabilities")
}

model club_bookings {
  id                         Int                   @id @default(autoincrement())
  booking_number             String                @unique @db.VarChar(30)
  member_id                  Int?
  member_name                String?               @db.VarChar(200)
  service_id                 Int
  schedule_id                Int
  availability_slot_id       Int?
  employee_id                Int? // denormalized provider for fast list/filter
  booking_date               String                @db.VarChar(10) // yyyy-mm-dd (the slot date)
  status                     ClubApptBookingStatus @default(pending)
  notes                      String?               @db.Text
  duration_min_snapshot      Int?
  price_snapshot             Decimal?              @db.Decimal(10, 2)
  coverage_type              String?               @db.VarChar(30)
  entitlement_key_snapshot   String?               @db.VarChar(50)
  payment_status             String?               @db.VarChar(30)
  entitlement_restored_at    DateTime?             @db.DateTime(0)
  entitlement_restored_by    Int?
  entitlement_restore_reason String?               @db.VarChar(500)
  branch_id                  Int?
  is_deleted                 Boolean               @default(false)
  created_at                 DateTime              @default(now())
  updated_at                 DateTime              @updatedAt

  schedule            club_schedules                          @relation(fields: [schedule_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  availability_slot   club_availability_slots?                @relation("NutritionAvailabilityBooking", fields: [availability_slot_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  service             club_services                           @relation(fields: [service_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  additional_services club_appt_booking_additional_services[]

  @@index([schedule_id])
  @@index([availability_slot_id])
  @@index([service_id])
  @@index([member_id])
  @@index([employee_id])
  @@index([booking_date])
  @@index([status])
  @@index([branch_id])
  @@map("club_bookings")
}

/// Additional-service choices enabled for a generic scheduling service.
/// Used by SPA appointments without coupling them to class-specific slots.
model club_service_additional_services {
  id                    Int      @id @default(autoincrement())
  parent_service_id     Int
  additional_service_id Int
  is_required           Boolean  @default(false)
  is_active             Boolean  @default(true)
  created_at            DateTime @default(now()) @db.DateTime(0)
  updated_at            DateTime @updatedAt @db.DateTime(0)

  parent_service     club_services @relation("BaseServiceAdditionalServices", fields: [parent_service_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  additional_service club_services @relation("AdditionalServiceCatalogLinks", fields: [additional_service_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@unique([parent_service_id, additional_service_id])
  @@index([additional_service_id])
  @@map("club_service_additional_services")
}

/// Additional service selected for a SPA/generic appointment booking.
model club_appt_booking_additional_services {
  id                    Int                            @id @default(autoincrement())
  booking_id            Int
  additional_service_id Int
  status                BookingAdditionalServiceStatus @default(confirmed)
  created_at            DateTime                       @default(now()) @db.DateTime(0)
  updated_at            DateTime                       @updatedAt @db.DateTime(0)

  booking            club_bookings @relation(fields: [booking_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  additional_service club_services @relation("AppointmentBookingAdditionalService", fields: [additional_service_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@unique([booking_id, additional_service_id])
  @@index([additional_service_id, status])
  @@map("club_appt_booking_additional_services")
}

/// Publishable monthly plan for one class and trainer.
model club_class_monthly_schedules {
  id           Int                        @id @default(autoincrement())
  class_id     Int
  trainer_id   Int
  month        Int                        @db.TinyInt
  year         Int                        @db.SmallInt
  status       ClassMonthlyScheduleStatus @default(draft)
  published_at DateTime?                  @db.DateTime(0)
  created_at   DateTime                   @default(now()) @db.DateTime(0)
  updated_at   DateTime                   @updatedAt @db.DateTime(0)

  class   club_lookups                @relation("MonthlyScheduleClassType", fields: [class_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  trainer club_trainers               @relation(fields: [trainer_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  slots   club_class_schedule_slots[]

  @@unique([class_id, trainer_id, month, year])
  @@index([status])
  @@map("club_class_monthly_schedules")
}

/// Concrete bookable occurrence within a monthly class plan.
model club_class_schedule_slots {
  id                  Int                     @id @default(autoincrement())
  monthly_schedule_id Int
  start_at            DateTime                @db.DateTime(0)
  end_at              DateTime                @db.DateTime(0)
  booking_start_at    DateTime?               @db.DateTime(0)
  booking_end_at      DateTime?               @db.DateTime(0)
  capacity            Int
  status              ClassScheduleSlotStatus @default(available)
  created_at          DateTime                @default(now()) @db.DateTime(0)
  updated_at          DateTime                @updatedAt @db.DateTime(0)

  monthly_schedule    club_class_monthly_schedules    @relation(fields: [monthly_schedule_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  additional_services club_slot_additional_services[]
  bookings            club_class_bookings[]

  @@index([monthly_schedule_id])
  @@index([start_at])
  @@index([status])
  @@map("club_class_schedule_slots")
}

/// Additional service enabled for a class by default.
model club_class_additional_services {
  id          Int      @id @default(autoincrement())
  class_id    Int
  service_id  Int
  is_required Boolean  @default(false)
  is_active   Boolean  @default(true)
  created_at  DateTime @default(now()) @db.DateTime(0)
  updated_at  DateTime @updatedAt @db.DateTime(0)

  class   club_lookups  @relation("AdditionalServiceClassType", fields: [class_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  service club_services @relation(fields: [service_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@unique([class_id, service_id])
  @@map("club_class_additional_services")
}

/// Additional service availability and capacity for one slot.
model club_slot_additional_services {
  id          Int      @id @default(autoincrement())
  slot_id     Int
  service_id  Int
  capacity    Int
  is_required Boolean  @default(false)
  is_active   Boolean  @default(true)
  created_at  DateTime @default(now()) @db.DateTime(0)
  updated_at  DateTime @updatedAt @db.DateTime(0)

  slot             club_class_schedule_slots          @relation(fields: [slot_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  service          club_services                      @relation(fields: [service_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  booking_services club_booking_additional_services[]

  @@unique([slot_id, service_id])
  @@map("club_slot_additional_services")
}

/// A user's reservation for one class schedule slot.
model club_class_bookings {
  id           Int                @id @default(autoincrement())
  slot_id      Int
  user_id      Int?
  member_id    Int?
  status       ClassBookingStatus @default(confirmed)
  booked_at    DateTime           @default(now()) @db.DateTime(0)
  cancelled_at DateTime?          @db.DateTime(0)
  created_at   DateTime           @default(now()) @db.DateTime(0)
  updated_at   DateTime           @updatedAt @db.DateTime(0)

  slot                club_class_schedule_slots          @relation(fields: [slot_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  user                users?                             @relation(fields: [user_id], references: [user_id], onDelete: NoAction, onUpdate: NoAction)
  member              club_members?                      @relation(fields: [member_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  additional_services club_booking_additional_services[]

  @@unique([slot_id, user_id])
  @@unique([slot_id, member_id])
  @@index([slot_id, status])
  @@index([user_id, status])
  @@index([member_id, status])
  @@map("club_class_bookings")
}

/// Additional service selected as part of a class booking.
model club_booking_additional_services {
  id                         Int                            @id @default(autoincrement())
  booking_id                 Int
  slot_additional_service_id Int
  service_id                 Int
  status                     BookingAdditionalServiceStatus @default(confirmed)
  created_at                 DateTime                       @default(now()) @db.DateTime(0)
  updated_at                 DateTime                       @updatedAt @db.DateTime(0)

  booking                 club_class_bookings           @relation(fields: [booking_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  slot_additional_service club_slot_additional_services @relation(fields: [slot_additional_service_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  service                 club_services                 @relation(fields: [service_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@unique([booking_id, service_id])
  @@index([slot_additional_service_id, status])
  @@map("club_booking_additional_services")
}

/// InBody result record — independent of scheduling. Registered after a
/// completed InBody appointment; provides per-member history.
model club_inbody_records {
  id          Int      @id @default(autoincrement())
  member_id   Int
  member_name String?  @db.VarChar(200)
  record_date String   @db.VarChar(10) // yyyy-mm-dd
  employee_id Int? // registering staff -> club_trainers.id
  staff_name  String?  @db.VarChar(150)
  file_url    String?  @db.VarChar(255) // PDF/image public url
  file_path   String?  @db.VarChar(255)
  weight      Decimal? @db.Decimal(6, 2)
  body_fat    Decimal? @db.Decimal(5, 2)
  muscle_mass Decimal? @db.Decimal(6, 2)
  bmi         Decimal? @db.Decimal(5, 2)
  notes       String?  @db.Text
  branch_id   Int?
  is_deleted  Boolean  @default(false)
  created_at  DateTime @default(now())
  updated_at  DateTime @updatedAt

  @@index([member_id])
  @@index([record_date])
  @@map("club_inbody_records")
}

/// Scheduling notifications — outbound event log for booking lifecycle & reminders.
/// Decoupled from the legacy tbl_notifications so the scheduling engine owns its
/// own channel without duplicating logic. A cron dispatches `pending` reminders.
enum ClubNotificationType {
  booking_confirmed
  booking_cancelled
  appointment_reminder
  schedule_changed
  member_message
}

model club_notifications {
  id          Int                  @id @default(autoincrement())
  type        ClubNotificationType
  booking_id  Int?
  schedule_id Int?
  member_id   Int?
  to_user     Int?
  title       String               @db.VarChar(200)
  message     String               @db.VarChar(1000)
  send_at     String?              @db.VarChar(19)
  status      String               @default("pending") @db.VarChar(20)
  channel     String               @default("in_app") @db.VarChar(20)
  branch_id   Int?
  created_at  DateTime             @default(now())
  updated_at  DateTime             @updatedAt

  @@index([status, send_at])
  @@index([booking_id])
  @@index([member_id])
  @@map("club_notifications")
}
