// =====================================================================================
//  CLUB MANAGEMENT (gym members, membership types, attendance)
// =====================================================================================

enum ClubGender {
  male
  female
}

enum ClubAttendanceStatus {
  checked_in
  checked_out
}

enum ClubSubStatus {
  active
  expired
  upcoming
  frozen
}

enum ClubPaymentMethod {
  cash
  card
  bank
  online
  visa
  transfer
  wallet
}

enum ClubRefundStatus {
  pending
  completed
  cancelled
}

/// Membership type catalog (price + duration). Old: MembershipTypes.
model club_membership_types {
  id            Int            @id @default(autoincrement())
  name          String         @db.VarChar(150)
  description   String?        @db.Text
  price         Decimal        @db.Decimal(10, 2)
  duration_days Int
  is_active     Boolean        @default(true)
  created_at    DateTime       @default(now())
  updated_at    DateTime       @updatedAt
  members       club_members[]

  @@map("club_membership_types")
}

/// Gym member. Old: Members.
model club_members {
  id                  Int                               @id @default(autoincrement())
  member_code         String                            @unique @db.VarChar(30)
  name                String                            @db.VarChar(200)
  phone               String?                           @db.VarChar(20)
  email               String?                           @db.VarChar(150)
  gender              ClubGender
  card_number         String?                           @db.VarChar(30)
  date_of_birth       String?                           @db.VarChar(10)
  address             String?                           @db.Text
  trainer_id          Int?
  sales_staff_id      Int?
  source_id           Int?
  emergency_name      String?                           @db.VarChar(150)
  emergency_phone     String?                           @db.VarChar(30)
  emergency_relation  String?                           @db.VarChar(80)
  marital_status      String?                           @db.VarChar(20)
  job_title           String?                           @db.VarChar(120)
  profile_picture     String?                           @db.VarChar(255)
  branch_id           Int
  membership_type_id  Int?
  start_date          String?                           @db.VarChar(10)
  end_date            String?                           @db.VarChar(10)
  notes               String?                           @db.Text
  is_active           Boolean                           @default(true)
  sales_id            Int?
  employee_id         Int?
  guardian_name       String?                           @db.VarChar(200)
  guardian_phone      String?                           @db.VarChar(20)
  app_user_id         Int?
  is_deleted          Boolean                           @default(false)
  created_by          Int?
  created_at          DateTime                          @default(now())
  updated_at          DateTime                          @updatedAt
  membership_type     club_membership_types?            @relation(fields: [membership_type_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  attendances         club_attendance[]
  subscriptions       club_subscriptions[]
  receipts            club_receipts[]
  refunds             club_subscription_refunds[]
  transfers           club_subscription_transfers[]
  class_bookings      club_class_bookings[]
  points_transactions club_member_points_transactions[]

  @@unique([phone], map: "uq_club_member_phone")
  @@index([branch_id])
  @@index([membership_type_id])
  @@index([card_number])
  @@index([name])
  @@index([phone])
  @@index([app_user_id])
  @@index([branch_id, is_active, is_deleted])
  @@map("club_members")
}

/// Member attendance / check-in. Old: MemberAttendances.
model club_attendance {
  id              Int                  @id @default(autoincrement())
  member_id       Int
  member_code     String               @db.VarChar(30)
  member_name     String               @db.VarChar(200)
  branch_id       Int
  check_in_time   DateTime             @default(now())
  check_out_time  DateTime?
  attendance_date String               @db.VarChar(10)
  status          ClubAttendanceStatus @default(checked_in)
  duration        Int?
  notes           String?              @db.Text
  created_by      Int?
  created_at      DateTime             @default(now())
  member          club_members         @relation(fields: [member_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([member_id])
  @@index([branch_id])
  @@index([attendance_date])
  @@index([status])
  @@index([member_code])
  @@index([attendance_date, check_in_time])
  @@map("club_attendance")
}

model club_subscription_types {
  id                           Int                               @id @default(autoincrement())
  name                         String                            @db.VarChar(150)
  branch_id                    Int?
  apply_to_all_branches        Boolean                           @default(false)
  price                        Decimal                           @db.Decimal(10, 2)
  days                         Int
  is_part_of_target            Boolean                           @default(false)
  invitations_count            Int?
  inbody_count                 Int?
  is_special_offer             Boolean                           @default(false)
  is_for_students              Boolean                           @default(false)
  show_in_app                  Boolean                           @default(false)
  notify_customers             Boolean                           @default(false)
  notify_on_expiry             Boolean                           @default(false)
  wallet_points                Int?
  offer_validity               String?                           @db.VarChar(10)
  is_linked_to_sessions        Boolean                           @default(false)
  sessions_count               Int?
  allow_multiple_daily_entries Boolean                           @default(false)
  is_linked_to_freeze          Boolean                           @default(false)
  /// Max number of times this package may be frozen (historical column name: freeze_days).
  freeze_days                  Int?
  includes_spa                 Boolean                           @default(false)
  spa_count                    Int?
  name_ar                      String?                           @db.VarChar(150)
  name_en                      String?                           @db.VarChar(150)
  package_category             String                            @default("regular") @db.VarChar(20)
  package_type                 String?                           @db.VarChar(100)
  duration_value               Int?
  duration_type                String                            @default("days") @db.VarChar(10)
  valid_upgrade_duration       Int?
  attendance_count             Int?
  min_price                    Decimal?                          @db.Decimal(10, 2)
  min_freeze                   Int?
  max_classes_per_day          Int?
  availability_from            String?                           @db.VarChar(10)
  availability_to              String?                           @db.VarChar(10)
  access_area_ids              Json?
  income_type                  String?                           @db.VarChar(100)
  description                  String?                           @db.Text
  benefits                     Json?
  week_planner                 Json?
  is_active                    Boolean                           @default(true)
  created_at                   DateTime                          @default(now())
  updated_at                   DateTime                          @updatedAt
  subscriptions                club_subscriptions[]
  branches                     club_subscription_type_branches[]

  @@map("club_subscription_types")
}

model club_subscription_type_branches {
  id                   Int                     @id @default(autoincrement())
  subscription_type_id Int
  branch_id            Int
  type                 club_subscription_types @relation(fields: [subscription_type_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([subscription_type_id, branch_id], map: "uq_sub_type_branch")
  @@index([branch_id])
  @@map("club_subscription_type_branches")
}

/// Singleton gym access policies (row id = 1).
model club_gym_policies {
  id                                       Int      @id @default(1)
  allow_checkin_with_outstanding           Boolean  @default(false)
  outstanding_alert_enabled                Boolean  @default(true)
  outstanding_alert_after_subscription_pct Int      @default(50)
  allow_refunds                            Boolean  @default(false)
  updated_at                               DateTime @updatedAt
  updated_by                               Int?

  @@map("club_gym_policies")
}

model club_subscriptions {
  id                           Int                               @id @default(autoincrement())
  subscription_number          String                            @unique @db.VarChar(30)
  registration_date            String                            @db.VarChar(10)
  branch_id                    Int
  member_id                    Int?
  customer_name                String?                           @db.VarChar(200)
  subscription_type_id         Int?
  subscription_type            String?                           @db.VarChar(150)
  subscription_start_date      String                            @db.VarChar(10)
  subscription_end_date        String                            @db.VarChar(10)
  subscription_value           Decimal                           @db.Decimal(10, 2)
  discount_enabled             Boolean                           @default(false)
  discount_value               Decimal                           @default(0) @db.Decimal(10, 2)
  paid_amount                  Decimal                           @default(0) @db.Decimal(10, 2)
  remaining_amount             Decimal                           @default(0) @db.Decimal(10, 2)
  gender                       ClubGender?
  employee_id                  Int?
  sales_id                     Int?
  payment_method               ClubPaymentMethod?
  receipt_number               String?                           @db.VarChar(30)
  customer_source_id           Int?
  guardian_name                String?                           @db.VarChar(200)
  guardian_phone               String?                           @db.VarChar(20)
  status                       ClubSubStatus                     @default(active)
  is_special                   Boolean                           @default(false)
  is_linked_to_sessions        Boolean                           @default(false)
  sessions_count               Int?
  sessions_used                Int                               @default(0)
  allow_multiple_daily_entries Boolean                           @default(false)
  is_time_based                Boolean                           @default(false)
  time_from                    String?                           @db.VarChar(8)
  time_to                      String?                           @db.VarChar(8)
  /// Per-member snapshot/override of the selected package benefits.
  benefits                     Json?
  free_benefit_notes           String?                           @db.Text
  created_by                   Int?
  created_at                   DateTime                          @default(now())
  updated_at                   DateTime                          @updatedAt
  member                       club_members?                     @relation(fields: [member_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  type                         club_subscription_types?          @relation(fields: [subscription_type_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  receipts                     club_receipts[]
  refunds                      club_subscription_refunds[]
  transfers                    club_subscription_transfers[]
  freezes                      club_subscription_freezes[]
  points_transactions          club_member_points_transactions[]

  @@index([member_id])
  @@index([branch_id])
  @@index([status])
  @@index([subscription_end_date])
  @@index([branch_id, status])
  @@map("club_subscriptions")
}

/// Immutable member loyalty-points ledger. The balance is the sum of `points`,
/// so every earn/redeem/adjustment remains auditable.
model club_member_points_transactions {
  id               Int                 @id @default(autoincrement())
  member_id        Int
  subscription_id  Int?
  points           Int
  transaction_type String              @db.VarChar(20)
  source           String              @db.VarChar(50)
  event_key        String              @unique @db.VarChar(190)
  description      String?             @db.VarChar(500)
  created_at       DateTime            @default(now())
  member           club_members        @relation(fields: [member_id], references: [id], onDelete: Restrict, onUpdate: NoAction)
  subscription     club_subscriptions? @relation(fields: [subscription_id], references: [id], onDelete: SetNull, onUpdate: NoAction)

  @@index([member_id, created_at])
  @@index([subscription_id])
  @@map("club_member_points_transactions")
}

model club_receipts {
  id              Int                 @id @default(autoincrement())
  receipt_number  String              @unique @db.VarChar(30)
  subscription_id Int?
  member_id       Int?
  member_name     String              @db.VarChar(200)
  amount          Decimal             @db.Decimal(10, 2)
  type            String?             @db.VarChar(50)
  payment_method  ClubPaymentMethod?
  receipt_date    String              @db.VarChar(10)
  status          String              @default("مدفوعة") @db.VarChar(30)
  description     String?             @db.Text
  created_at      DateTime            @default(now())
  updated_at      DateTime            @updatedAt
  subscription    club_subscriptions? @relation(fields: [subscription_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  member          club_members?       @relation(fields: [member_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([subscription_id])
  @@index([member_id])
  @@index([receipt_date])
  @@map("club_receipts")
}

model club_customer_sources {
  id         Int      @id @default(autoincrement())
  name       String   @db.VarChar(120)
  is_active  Boolean  @default(true)
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  @@map("club_customer_sources")
}

model club_subscription_refunds {
  id                  Int                @id @default(autoincrement())
  subscription_id     Int
  member_id           Int?
  customer_name       String?            @db.VarChar(200)
  subscription_type   String?            @db.VarChar(150)
  original_start_date String             @db.VarChar(10)
  original_end_date   String             @db.VarChar(10)
  stop_date           String             @db.VarChar(10)
  remaining_days      Int
  original_value      Decimal            @db.Decimal(10, 2)
  daily_rate          Decimal            @db.Decimal(10, 4)
  refund_amount       Decimal            @db.Decimal(10, 2)
  invoice_number      String             @unique @db.VarChar(30)
  refund_date         String             @db.VarChar(10)
  reason              String?            @db.Text
  notes               String?            @db.Text
  status              ClubRefundStatus   @default(pending)
  branch_id           Int?
  created_by          Int?
  created_at          DateTime           @default(now())
  subscription        club_subscriptions @relation(fields: [subscription_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  member              club_members?      @relation(fields: [member_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([subscription_id])
  @@index([member_id])
  @@index([status])
  @@map("club_subscription_refunds")
}

model club_subscription_freezes {
  id                Int                @id @default(autoincrement())
  subscription_id   Int
  freeze_start_date String             @db.VarChar(10)
  /// Planned end (freeze_start + planned_days); actual end set on unfreeze.
  freeze_end_date   String?            @db.VarChar(10)
  planned_days      Int
  actual_days       Int?
  /// Subscription end date before the freeze, restored+extended on unfreeze.
  original_end_date String             @db.VarChar(10)
  reason            String?            @db.Text
  is_active         Boolean            @default(true)
  branch_id         Int?
  created_by        Int?
  created_at        DateTime           @default(now())
  updated_at        DateTime           @updatedAt
  subscription      club_subscriptions @relation(fields: [subscription_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([subscription_id])
  @@index([is_active])
  @@map("club_subscription_freezes")
}

model club_subscription_transfers {
  id                     Int                @id @default(autoincrement())
  subscription_id        Int
  member_id              Int?
  customer_name          String?            @db.VarChar(200)
  from_subscription_type String?            @db.VarChar(150)
  to_subscription_type   String?            @db.VarChar(150)
  from_start_date        String?            @db.VarChar(10)
  from_end_date          String?            @db.VarChar(10)
  to_start_date          String?            @db.VarChar(10)
  to_end_date            String?            @db.VarChar(10)
  from_value             Decimal?           @db.Decimal(10, 2)
  to_value               Decimal?           @db.Decimal(10, 2)
  transfer_date          String             @db.VarChar(10)
  reason                 String?            @db.Text
  branch_id              Int?
  created_by             Int?
  created_at             DateTime           @default(now())
  subscription           club_subscriptions @relation(fields: [subscription_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  member                 club_members?      @relation(fields: [member_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([subscription_id])
  @@index([member_id])
  @@map("club_subscription_transfers")
}

