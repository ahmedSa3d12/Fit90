/// Hierarchical country/city/region lookup. Engine=InnoDB, utf8mb3. PK main_id (AI). KEY from_id.
model conf_country_setting {
  main_id   Int              @id @default(autoincrement())
  name      String?          @db.VarChar(100)
  from_id   Int? // self-ref parent (declared KEY in dump)
  from_type CountryFromType?
  created   DateTime         @default(now()) @db.DateTime(0)
  updated   DateTime?        @db.DateTime(0)

  @@index([from_id])
  @@map("conf_country_setting")
}

