model users {
  user_id              Int     @id @default(autoincrement())
  agent_brok_fk        Int? // FK-by-convention
  emp_code             Int? // FK-by-convention -> employees.emp_code (varchar/int mismatch; not enforced)
  username             String? @db.VarChar(40)
  password             String? @db.VarChar(255) // bcrypt going forward; legacy sha1(md5) tolerated until rehash on login
  name                 String? @db.VarChar(100)
  email                String? @db.VarChar(50)
  address              String? @db.VarChar(200)
  level                Int? // COMMENT '1:admin , 2:emp'
  role_id_fk           Int? // FK-by-convention -> role (out of scope)
  image                String? @db.VarChar(500)
  x_y_z                String? @db.VarChar(300)
  branch_id_fk         Int? // FK-by-convention -> tbl_branches.branch_id
  app_pass             String? @db.VarChar(100) // SHA-1 hex (mobile)
  approved             Int?    @default(1) // bool-as-int
  pass_demo            String? @db.VarChar(100)
  user_pass            String? @db.VarChar(500) // duplicate password store
  device_token         String  @default("") @db.VarChar(255) // legacy NOT NULL w/o default — defaulted for strict InnoDB
  must_change_password Boolean @default(false)

  // Safe relation: permissions junction keyed by user_id (int = int).
  permissions    permissions[]
  class_bookings club_class_bookings[]

  @@map("users")
}

/// Navigation/menu pages + permission targets. Engine=MyISAM, utf8mb3. PK page_id (AI=302).
model pages {
  page_id        Int     @id @default(autoincrement())
  page_title     String  @db.VarChar(255)
  page_link      String  @db.VarChar(255)
  group_id_fk    Int // menu group (FK-by-convention)
  level          Int
  page_order     Int
  page_icon_code String  @db.VarChar(255)
  page_photo     String  @default("0") @db.VarChar(500)
  bg_color       String? @db.VarChar(10)
  width          String? @db.VarChar(10)
  color          String? @db.VarChar(10)
  class          String? @db.VarChar(10)

  permissions permissions[]

  @@map("pages")
}

/// RBAC junction user<->page. Engine=InnoDB, utf8mb3, 6572 rows.
/// HAZARD: original table has NO primary key / NO index. We synthesize a composite PK here.
/// VERIFY (user_id, page_id_fk) is unique before migrating; otherwise switch to a surrogate id.
model permissions {
  user_id    Int // -> users.user_id
  page_id_fk Int // -> pages.page_id
  page_level Int // access level

  user users @relation(fields: [user_id], references: [user_id], onDelete: NoAction, onUpdate: NoAction)
  page pages @relation(fields: [page_id_fk], references: [page_id], onDelete: NoAction, onUpdate: NoAction)

  @@id([user_id, page_id_fk])
  @@index([page_id_fk])
  @@map("permissions")
}

/// Mobile app screens. Engine=InnoDB, utf8mb4_0900_ai_ci. PK id (AI=23).
model app_pages {
  id             Int     @id @default(autoincrement())
  title          String? @db.VarChar(50)
  active         YesNo   @default(yes)
  page_order     Int?
  screen_num     Int?    @db.TinyInt
  icon_path      String? @db.VarChar(300)
  icon_path_past String? @db.VarChar(200)

  @@map("app_pages")
}

/// Per-user delivered notifications. Engine=MyISAM, utf8mb3_unicode_ci, 19921 rows. PK id (AI).
model users_notifications {
  id           Int     @id @default(autoincrement())
  notify_id_fk Int? // FK-by-convention -> tbl_notifications / tbl_sys_notifications_settings
  message      String? @db.VarChar(1000)
  url          String? @db.VarChar(100)
  date         String? @db.VarChar(100) // date-string
  type         Int?    @db.TinyInt
  approved     Int?    @db.TinyInt // bool-as-tinyint

  @@map("users_notifications")
}

/// Notification events. Engine=InnoDB, utf8mb3. PK id (AI=65).
model tbl_notifications {
  id           Int     @id @default(autoincrement())
  from_user    Int? // -> users.user_id (FK-by-convention)
  to_user      Int? // -> users.user_id (FK-by-convention)
  date_ar      String? @db.VarChar(15) // date-string
  time_ar      String? @db.VarChar(15) // time-string
  seen         Int     @default(0) @db.TinyInt // bool
  seen_date    String? @db.VarChar(15) // date-string
  seen_time    String? @db.VarChar(10) // time-string
  fk_id        BigInt? // polymorphic target id
  notify_id_fk Int?
  n_code       Int?
  test_num     Int?

  @@index([to_user, seen])
  @@index([to_user, n_code, fk_id, seen])
  @@map("tbl_notifications")
}

/// Notification type/route registry. Engine=InnoDB, utf8mb3. PK id (AI=18).
model tbl_sys_notifications_settings {
  id      Int     @id @default(autoincrement())
  code    Int?
  t_table String? @db.VarChar(100) // target table name (polymorphic)
  url     String? @db.VarChar(100)
  title   String? @db.VarChar(100)

  @@map("tbl_sys_notifications_settings")
}

