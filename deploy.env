# ============================================================================
# FIT90 GYM — PRODUCTION .env for fit90.metacodecx.com (WHM/cPanel).
# This file is copied INTO the release zip as `.env` by make-release.sh, so you
# never restore it separately. Password in DATABASE_URL is URL-encoded.
# If the DB import fails on a password issue, the leading "=" is part of the
# password → encoded as %3D (see the two options below).
# ============================================================================

# --- MySQL: existing prod DB (metacodecx_fit90). Password URL-encoded. --------
#   A) =g)6jV!NKd24UG41  →  %3Dg)6jV!NKd24UG41   (current)
#   B) g)6jV!NKd24UG41    →  g)6jV!NKd24UG41
DATABASE_URL="mysql://metacodecx_onemelion:%3Dg)6jV!NKd24UG41@localhost:3306/metacodecx_fit90"

# --- App ---------------------------------------------------------------------
NODE_ENV=production
# This server proxies Apache → 127.0.0.1:4444 (server-deploy.sh enforces it).
PORT=4444
# Same-origin deploy: API (/api) + SPA on one domain.
CORS_ORIGINS="https://fit90.metacodecx.com"

# --- Auth --------------------------------------------------------------------
JWT_ACCESS_SECRET="85595a638cd1ad386772324bddd2d630b46dc277e8d6ee788b495d9d1d97671c"
JWT_REFRESH_SECRET="b6b610032e7dc158e1ac2347cf63f37b45ed384f6f2f8229019ca0e477da57a7"
JWT_ACCESS_TTL="2h"
JWT_REFRESH_TTL="90d"
BCRYPT_ROUNDS=12

# --- File uploads ------------------------------------------------------------
UPLOAD_DIR="./uploads"
PUBLIC_UPLOAD_BASE="/uploads"

# --- Optional (background jobs fall back to in-process without Redis) ---------
REDIS_URL="redis://localhost:6379"
